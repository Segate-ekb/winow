
&Пластилин
Перем Настройки;

&Пластилин
Перем НативныйОбработчикЗапросов;

Перем ВебСервер;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Процедура Старт() Экспорт

	ЗапуститьСинхронно();

КонецПроцедуры

Процедура Стоп() Экспорт

	Если Не ВебСервер = Неопределено Тогда
		ВебСервер.Остановить();
	КонецЕсли;

КонецПроцедуры

Процедура ЗапуститьСинхронно() Экспорт
	СоздатьСервер();
	ВебСервер.Запустить();
КонецПроцедуры

Функция ПолучитьНативныйСервер() Экспорт
	СоздатьСервер();
	Возврат ВебСервер;
КонецФункции

Процедура СоздатьСервер()
	Если ВебСервер = Неопределено Тогда
		ВебСервер = Новый ВебСервер(Настройки.Порт);
		ВебСервер.ДобавитьОбработчикЗапросов(ЭтотОбъект, "ОбработатьЗапрос");
	КонецЕсли;
КонецПроцедуры

// Разбор и обработка - два отдельных вызова к соседнему желудю: вокруг обработки
// открывается серверный спан OpenTelemetry, а открыть его раньше нельзя, потому
// что контекст трассировки извлекается из заголовков запроса winow.
//
// Конвейер идёт прямо в потоке Kestrel и при включённой телеметрии: opentelemetry 1.1.0
// держит стек контекстов в данных потока исполнения, и УИД фонового задания ему больше
// не нужен. Заворачивать обработку в ФоновыеЗадания.Выполнить нельзя: реестр заданий
// OneScript не чистится, и контекст каждого запроса остаётся в нём до перезапуска.
//
Процедура ОбработатьЗапрос(Контекст, СледующийОбработчик) Экспорт // BSLLS:UnusedParameters-off

	Запрос = НативныйОбработчикЗапросов.РазобратьЗапрос(Контекст);

	НативныйОбработчикЗапросов.ОбработатьРазобранныйЗапрос(Запрос, Контекст);

КонецПроцедуры
