#Использовать autumn
#Использовать opentelemetry
#Использовать ".."
#Использовать "поддержка"
#Использовать asserts

// Интеграция winow с OpenTelemetry на нативном веб-сервере.
//
// Нативный сервер обрабатывает запрос прямо в потоке пула Kestrel. Контекст
// трассировки живёт в данных потока исполнения, поэтому свой стек контекстов
// есть у каждого запроса и заворачивать обработку в фоновое задание не нужно.
//
// Набор проверяет обе стороны этого: что фонового задания вокруг конвейера нет
// и что контекст трассировки при этом не теряется и не перемешивается.

Перем Поделка;
Перем Порт;

// Отдельный процесс, а не просто своя поделка: SDK OTel регистрируется глобально
// один раз на процесс, и в общем прогоне его успевает занять соседний набор -
// тогда ОтелSdk в этой поделке не создаётся и желудь приезжает пустым.
&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс",
	Совет = "() -> НастройкиТрассировки.СоветСТрассировкойНаНативномСервере()")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка) Экспорт
	Поделка = _Поделка;
	Порт = НастройкиТрассировки.ПортНативногоСервера();
КонецПроцедуры

&ПередВсеми
Процедура ЗапуститьСервер() Экспорт

	// Обработчик запросов создаётся заранее: именно его создание заставляет
	// напильник поднять SDK и зарегистрировать его глобально.
	Поделка.НайтиЖелудь("НативныйОбработчикЗапросов");

	ВебСервер = Поделка.НайтиЖелудь("ВебСервер");
	ФоновыеЗадания.Выполнить(ВебСервер, "Старт");
	// Подождем что бы сервер успел запустится и проинициализироваться.
	Приостановить(1000);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСервер() Экспорт

	Попытка
		Поделка.НайтиЖелудь("ВебСервер").Стоп();
	Исключение
		// Сервер уже остановлен - ронять из-за этого прогон незачем.
	КонецПопытки;

КонецПроцедуры

// Деталька otel.enabled задана строкой "true" - в том виде, в каком её отдаёт
// провайдер переменных среды. Если бы её не приводили к булеву, напильник либо
// не нашёл бы шов, либо уронил бы старт приложения.
&Тест
Процедура ДеталькаСтрокойВключаетТрассировку() Экспорт

	// Когда
	Желудь = Поделка.НайтиЖелудь("НативныйОбработчикЗапросов");

	// Тогда - желудь обёрнут декоратором напильника, а значит трассировка включена
	Ожидаем.Что(Строка(ТипЗнч(Желудь)), "тип желудя НативныйОбработчикЗапросов")
		.ЭтоНе().Равно("НативныйОбработчикЗапросов");

КонецПроцедуры

// Включённая трассировка не должна менять поведение обычного запроса.
&Тест
Процедура ЗапросыОбрабатываютсяКакОбычно() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/checkup");

	// Тогда
	Ожидаем.Что(Ответ.КодСостояния, "код состояния").Равно(200);

КонецПроцедуры

// Конвейер идёт прямо в потоке Kestrel. Появись здесь идентификатор задания -
// значит обработку снова завернули в ФоновыеЗадания.Выполнить, а реестр заданий
// OneScript не чистится: параметры каждого запроса остались бы в нём навсегда.
&Тест
Процедура ЗапросОбрабатываетсяВнеФоновогоЗадания() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/otel/thread");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),
		"идентификатор фонового задания обработки").Равно("нет");

КонецПроцедуры

// Стек контекстов OpenTelemetry лежит в данных потока исполнения, поэтому у запросов,
// которые сервер обрабатывает одновременно, потоки обязаны быть разными. Один поток
// на всех свалил бы их контексты в общий стек.
&Тест
Процедура ОдновременныеЗапросыИдутВРазныхПотокахИсполнения() Экспорт

	// Когда
	Потоки = ВолнаОтветов("/tests/otel/execthread", БезТрасс());

	// Тогда
	Ожидаем.Что(РазличныхЗначений(Потоки),
		СтрШаблон("различных потоков исполнения на %1 одновременных запросов; получено: %2",
			ЗапросовВВолне(), СтрСоединить(Потоки, ", "))).Равно(ЗапросовВВолне());

КонецПроцедуры

// Тот же инвариант со стороны пользователя: каждый одновременный запрос обязан
// отчитаться о СВОЕЙ трассе. Перемешайся стеки - запрос вернул бы идентификатор
// соседа, и трасса в бэкенде показывала бы чужую работу. По очереди запросы верны
// и на общем стеке, поэтому волна уходит параллельно и задерживается внутри сервера.
&Тест
Процедура ОдновременныеЗапросыНеПеремешиваютТрассы() Экспорт

	// Дано
	Трассы = ВолнаТрасс();

	// Когда
	Ответы = ВолнаОтветов("/tests/otel/slowtraceid", Трассы);

	// Тогда
	Для Индекс = 0 По Трассы.ВГраница() Цикл
		Ожидаем.Что(Ответы[Индекс],
			СтрШаблон("запрос %1 отчитался о своей трассе", Индекс + 1)).Равно(Трассы[Индекс]);
	КонецЦикла;

КонецПроцедуры

// Спан метода контроллера создаёт autumn-opentelemetry, а его родителем
// становится серверный спан от winow. Без живого контекста трассировки
// спан метода оказался бы корневым и родителя бы не имел.
&Тест
Процедура СерверныйСпанСтановитсяРодителемСпанаМетода() Экспорт

	// Когда
	Ответ = ГетЗапрос("/tests/otel/parent");

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "родительский спан")
		.ЭтоНе().Равно("нет");

КонецПроцедуры

&Тест
Процедура ВходящийTraceparentПродолжаетТрассировку() Экспорт

	// Дано
	ИдТрассировки = "4bf92f3577b34da6a3ce929d0e0e4736";
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("traceparent", "00-" + ИдТрассировки + "-00f067aa0ba902b7-01");

	// Когда
	Ответ = ГетЗапрос("/tests/otel/traceid", Заголовки);

	// Тогда
	Ожидаем.Что(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8), "идентификатор трассировки")
		.Равно(ИдТрассировки);

КонецПроцедуры

Функция ГетЗапрос(Адрес, Заголовки = Неопределено)

	Соединение = Новый HTTPСоединение("http://localhost", Порт, , , , 15);
	Запрос = Новый HTTPЗапрос(Адрес);

	Если Заголовки <> Неопределено Тогда
		Запрос.Заголовки = Заголовки;
	КонецЕсли;

	Возврат Соединение.Получить(Запрос);

КонецФункции

// Сколько запросов уходит в сервер одновременно.
Функция ЗапросовВВолне()
	Возврат 4;
КонецФункции

// Идентификаторы трасс волны: 32 шестнадцатеричных знака, ровно столько даёт УИД
// без дефисов. Каждый запрос волны приносит свой - входящим traceparent.
Функция ВолнаТрасс()

	Результат = Новый Массив();
	Для Счёт = 1 По ЗапросовВВолне() Цикл
		Результат.Добавить(СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", ""));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Волна без входящих трасс: спан рождается корневым, заголовок не ставится.
Функция БезТрасс()

	Результат = Новый Массив();
	Для Счёт = 1 По ЗапросовВВолне() Цикл
		Результат.Добавить("");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ответы волны одновременных запросов, по одному на каждую трассу и в том же порядке.
// Каждое задание пишет свой ответ в СВОЙ элемент массива: массив не перестраивается,
// и синхронизация записи не нужна.
Функция ВолнаОтветов(Адрес, Трассы)

	Ответы = Новый Массив(Трассы.Количество());
	Задания = Новый Массив();

	Для Индекс = 0 По Трассы.ВГраница() Цикл
		Параметры = Новый Массив();
		Параметры.Добавить(Адрес);
		Параметры.Добавить(Трассы[Индекс]);
		Параметры.Добавить(Индекс);
		Параметры.Добавить(Ответы);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "СпроситьВЗадании", Параметры));
	КонецЦикла;

	ФоновыеЗадания.ОжидатьВсе(Задания);

	Возврат Ответы;

КонецФункции

// Точка входа фонового задания волны: один запрос под своей трассой.
//
// Параметры:
//  Адрес   - Строка  - Адрес запроса.
//  Трасса  - Строка  - Идентификатор трассы; пустая строка - без traceparent.
//  Индекс  - Число   - Место ответа в массиве ответов.
//  Ответы  - Массив  - Массив ответов волны.
//
Процедура СпроситьВЗадании(Адрес, Трасса, Индекс, Ответы) Экспорт

	Заголовки = Неопределено;

	Если ЗначениеЗаполнено(Трасса) Тогда
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("traceparent",
			СтрШаблон("00-%1-%2-01", Трасса, Лев(Трасса, 16)));
	КонецЕсли;

	Ответ = ГетЗапрос(Адрес, Заголовки);
	Ответы.Установить(Индекс, Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));

КонецПроцедуры

Функция РазличныхЗначений(Значения)

	Виденные = Новый Соответствие();
	Для Каждого Значение Из Значения Цикл
		Виденные.Вставить(Значение, Истина);
	КонецЦикла;

	Возврат Виденные.Количество();

КонецФункции
