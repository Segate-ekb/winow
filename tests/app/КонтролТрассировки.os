#Использовать opentelemetry

// Контроллер для проверки интеграции winow с OpenTelemetry.
// Отдаёт наружу состояние активного контекста трассировки, чтобы тесты
// могли утверждать о нём по обычному HTTP-ответу, не залезая во внутренности SDK.

&Контроллер("/tests/otel")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

// Возвращает идентификатор трассировки активного спана
// либо "нет" - если во время обработки запроса спан не активен.
&ТочкаМаршрута("traceid")
Процедура ИдентификаторТрассировки(Ответ) Экспорт

	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = ЗначениеИлиНет(ИдТрассировкиАктивногоСпана());

КонецПроцедуры

// Возвращает идентификатор родительского спана для активного спана метода
// либо "нет" - если родителя нет.
//
// Спан метода создаёт autumn-opentelemetry, а его родителем становится
// серверный спан, который заводит winow. Поэтому наличие родителя и есть
// признак того, что серверный спан вокруг запроса действительно создан.
&ТочкаМаршрута("parent")
Процедура РодительскийСпан(Ответ) Экспорт

	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = ЗначениеИлиНет(ИдРодительскогоСпана());

КонецПроцедуры

// Возвращает шаблон маршрута, которому сопоставился запрос.
// Точка маршрута нарочно шаблонная: проверяется, что в шаблоне остаются
// имена параметров, а не подставленные значения.
&ТочкаМаршрута("route/{Первый}/mult/{Второй}")
Процедура ШаблонМаршрутаЗапроса(Ответ, Запрос) Экспорт

	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = ЗначениеИлиНет(Запрос.ШаблонМаршрута);

КонецПроцедуры

// Возвращает идентификатор фонового задания, в котором обрабатывается запрос,
// либо "нет" - если обработка идёт не в фоновом задании.
//
// Нативный сервер обрабатывает запрос прямо в потоке Kestrel, поэтому здесь
// ожидается именно "нет": появление идентификатора означало бы, что конвейер
// опять кем-то завёрнут в ФоновыеЗадания.Выполнить.
&ТочкаМаршрута("thread")
Процедура ИдентификаторПотока(Ответ) Экспорт

	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = ЗначениеИлиНет(ИдТекущегоФоновогоЗадания());

КонецПроцедуры

// Возвращает идентификатор потока исполнения, в котором обрабатывается запрос.
// Именно в данных этого потока ОтелКонтекст держит стек контекстов, поэтому
// у одновременных запросов идентификаторы обязаны различаться.
//
// Обработка задерживается: без задержки параллельные запросы успевают
// разойтись во времени, и один поток мог бы обслужить их по очереди.
&ТочкаМаршрута("execthread")
Процедура ИдентификаторПотокаИсполнения(Ответ) Экспорт

	Приостановить(ЗадержкаОбработкиМс());

	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = ЗначениеИлиНет(Строка(ТекущийПоток().Идентификатор));

КонецПроцедуры

// Возвращает идентификатор трассировки активного спана, задержавшись в обработке
// настолько, чтобы параллельные запросы наверняка встретились внутри сервера.
// Перемешанные стеки контекстов видны только так: по очереди они верны всегда.
&ТочкаМаршрута("slowtraceid")
Процедура ИдентификаторТрассировкиСЗадержкой(Ответ) Экспорт

	Приостановить(ЗадержкаОбработкиМс());

	Ответ.УстановитьТипКонтента("txt");
	Ответ.ТелоТекст = ЗначениеИлиНет(ИдТрассировкиАктивногоСпана());

КонецПроцедуры

Функция ЗадержкаОбработкиМс()
	Возврат 500;
КонецФункции

Функция ИдТекущегоФоновогоЗадания()

	Задание = ФоновыеЗадания.ПолучитьТекущее();

	Если Задание = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Задание.УникальныйИдентификатор);

КонецФункции

Функция ИдРодительскогоСпана()

	Спан = ОтелКонтекст.ТекущийСпан();

	Если Спан = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	КонтекстРодителя = Спан.КонтекстРодительскогоСпана();

	Если КонтекстРодителя = Неопределено ИЛИ НЕ КонтекстРодителя.Валиден() Тогда
		Возврат "";
	КонецЕсли;

	Возврат КонтекстРодителя.ИдСпана();

КонецФункции

Функция ИдТрассировкиАктивногоСпана()

	Спан = ОтелКонтекст.ТекущийСпан();

	Если Спан = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	КонтекстСпана = Спан.КонтекстСпана();

	Если КонтекстСпана = Неопределено ИЛИ НЕ КонтекстСпана.Валиден() Тогда
		Возврат "";
	КонецЕсли;

	Возврат КонтекстСпана.ИдТрассировки();

КонецФункции

Функция ЗначениеИлиНет(Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, "нет");
КонецФункции
